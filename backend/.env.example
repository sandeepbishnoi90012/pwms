# Copy this file to ".env" (same folder) and fill in your database details. Never commit ".env".

# ---- Option A: local MySQL (XAMPP / MySQL installer) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pwms
DB_SSL=false

# ---- Option B: TiDB Cloud (free hosted MySQL) - replace the values above with these ----
# DB_HOST=gateway01.xx-xxxx-x.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=xxxxxxxx.root
# DB_PASSWORD=your-password
# DB_NAME=pwms
# DB_SSL=true

# ---- Optional ----
# PORT=5000
# FRONTEND_ORIGIN=http://localhost:3000
# JWT_SECRET=change-me
